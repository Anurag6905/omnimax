POSTGRES_DB=omnimax
DATABASE_URL=postgresql://omnimax:change-me@localhost:5432/omnimax

# API
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
